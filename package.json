{
    "name": "lunchmoney-readonly-cloudflare",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.15.0",
    "description": "Single-user, read-only-by-default Lunch Money MCP server for ChatGPT on Cloudflare Workers with Google OAuth.",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "cf-typegen": "wrangler types",
        "test": "vitest run --passWithNoTests && pnpm run test:access",
        "test:access": "pnpm --dir vendor-lunchmoney-mcp build && node --test vendor-lunchmoney-mcp/test/readonly.server.test.mjs vendor-lunchmoney-mcp/test/categorization.server.test.mjs",
        "test:readonly": "pnpm --dir vendor-lunchmoney-mcp build && node --test vendor-lunchmoney-mcp/test/readonly.server.test.mjs",
        "test:categorize": "pnpm --dir vendor-lunchmoney-mcp build && node --test vendor-lunchmoney-mcp/test/categorization.server.test.mjs",
        "check:public-release": "node scripts/check-public-release.mjs"
    },
    "dependencies": {
        "@akutishevsky/lunchmoney-mcp": "file:vendor-lunchmoney-mcp",
        "@bm1549/remote-mcp-cloudflare": "0.3.0",
        "@modelcontextprotocol/server": "2.0.0",
        "agents": "0.22.0",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.22.0",
        "@cloudflare/workers-types": "5.20260827.1",
        "@eslint/js": "10.0.1",
        "eslint": "10.8.1",
        "typescript": "7.0.2",
        "typescript-eslint": "8.68.0",
        "vitest": "4.1.11",
        "wrangler": "4.127.0"
    },
    "overrides": {
        "agents": "$agents",
        "@modelcontextprotocol/server": "$@modelcontextprotocol/server"
    }
}
