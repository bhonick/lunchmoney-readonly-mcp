{
    "name": "lunchmoney-readonly-cloudflare",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Single-user, read-only Lunch Money MCP server for ChatGPT on Cloudflare Workers with Google OAuth.",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "cf-typegen": "wrangler types",
        "test": "vitest run --passWithNoTests",
        "test:readonly": "node --test --test-isolation=none vendor-lunchmoney-mcp/test/readonly.server.test.mjs",
        "check:public-release": "node scripts/check-public-release.mjs"
    },
    "dependencies": {
        "@akutishevsky/lunchmoney-mcp": "file:vendor-lunchmoney-mcp",
        "@bm1549/remote-mcp-cloudflare": "0.3.0",
        "@modelcontextprotocol/server": "2.0.0",
        "agents": "0.20.1",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.21.2",
        "@cloudflare/workers-types": "5.20260813.1",
        "@eslint/js": "10.0.1",
        "eslint": "10.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vitest": "4.1.10",
        "wrangler": "4.122.0"
    },
    "overrides": {
        "agents": "$agents",
        "@modelcontextprotocol/server": "$@modelcontextprotocol/server"
    }
}
