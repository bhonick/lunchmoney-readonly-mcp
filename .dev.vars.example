# Local development secrets. Copy to .dev.vars (gitignored) before running `wrangler dev`.
# In production, set each of these with `wrangler secret put <NAME>` instead.

# Google OAuth Web client (https://console.cloud.google.com/apis/credentials).
# The redirect URI registered there must be your worker URL + /authorize/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required. Comma-separated allowlist of Google account email addresses.
# The Worker fails closed when this is empty. Matching is case-insensitive.
ALLOWED_EMAILS=

# Random secret used to sign OAuth state. Generate with:
#   openssl rand -hex 32
STATE_SECRET=

# Lunch Money token. In production this must be a Worker secret, never a var.
LUNCHMONEY_API_TOKEN=
