{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Pick a unique Worker name for your Cloudflare account before deploying.
    "name": "lunchmoney-readonly-mcp",
    "main": "src/worker.ts",
    "compatibility_date": "2025-03-10",
    "compatibility_flags": ["nodejs_compat"],
    "secrets": {
        "required": [
            "LUNCHMONEY_API_TOKEN",
            "GOOGLE_CLIENT_ID",
            "GOOGLE_CLIENT_SECRET",
            "ALLOWED_EMAILS",
            "STATE_SECRET"
        ]
    },
    "kv_namespaces": [
        {
            // OAuth provider grant store (DCR registrations + issued tokens).
            //   npx wrangler kv namespace create OAUTH_KV
            "binding": "OAUTH_KV",
            // Replace this after running: npx wrangler kv namespace create OAUTH_KV
            "id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID"
        }
    ],
    "ratelimits": [
        {
            // Per-IP rate limit on dynamic OAuth client registration.
            "name": "REGISTER_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 2, "period": 60 }
        }
    ],
    "observability": {
        "enabled": true
    }
}
